# Список настроек. Сам файл .env в репозиторий не попадает.
# Локально .env создаёт start.sh со значениями для своего компьютера.
# На боевом сервере те же имена, другие значения: код не меняется.

# --- Сайт ---
PUBLIC_URL=                 # локально http://localhost:3000, боевой https://<домен>
SESSION_SECRET=             # длинная случайная строка (64+ символа)
NODE_ENV=                   # development | production
PORT=                       # порт приложения, 3000

# --- База ---
DB_PASSWORD=                # локально любой, на сервере длинный случайный
DATABASE_URL=               # postgres://nika:<DB_PASSWORD>@<хост>:5432/nika

# --- Хранилище видео (локально SeaweedFS, боевой S3 Timeweb) ---
S3_ENDPOINT=                # адрес, к которому обращается сервер
S3_PUBLIC_ENDPOINT=         # адрес для браузера (подписанные ссылки); на бою совпадает с S3_ENDPOINT
S3_REGION=                  # локально us-east-1, Timeweb — из панели (не проверено)
S3_BUCKET=                  # например nika-videos
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Почта (локально Mailpit) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=                # 1 — шифрованное соединение (на бою), 0 — локально
MAIL_FROM=                  # noreply@mail.<домен>
MAIL_REPLY_TO=              # живой ящик Ники
ADMIN_NOTIFY_EMAIL=         # куда слать уведомления об оплатах

# --- Robokassa (тестовый режим) ---
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_TEST=             # 1 — тестовый режим, 0 — боевой

# --- Только боевой сервер (их собирает GitHub Actions из секретов, руками не заполнять) ---
INITIAL_ADMINS=             # первые админы, один раз: owner:почта:Имя,staff:почта:Имя,tech:почта:Имя
BACKUP_S3_ENDPOINT=         # отдельное S3-хранилище для бэкапов (не то, где видео)
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_PASSPHRASE=          # пароль шифрования бэкапов, 32+ символа; копию хранить вне сервера
ALERT_EMAIL=                # куда писать, если бэкап или проверка восстановления не прошли
